# DAQ USB auto-update: when a USB mass-storage partition appears, start the
# templated updater service (which ignores sticks without an update bundle).
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
    SUBSYSTEMS=="usb", ENV{ID_FS_USAGE}=="filesystem", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="daq-usb-update@%k.service"

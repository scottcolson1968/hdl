#
# Put the AD4080 into the WildCat2 operating point (4.096 MSPS) before any IIO
# daemon starts serving clients, so a client never sees the power-on default of
# no filtering.

[Unit]
Description=AD4080 default operating point (4.096 MSPS)
ConditionPathExists=/sys/bus/iio
Before=iiod.service iiod_ffs.service iiod026.service

[Service]
ExecStart=/bin/bash /usr/local/bin/daq-adc-defaults
RemainAfterExit=yes
Type=oneshot

[Install]
WantedBy=multi-user.target
